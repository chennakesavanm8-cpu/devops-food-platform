services:
  order-service:
    build:
      context: ./services/order-service
    ports:
      - "5001:5001"
    networks:
      - food-network
    volumes:
      - order-data:/data

  user-service:
    build:
      context: ./services/user-service
    ports:
      - "5000:5000"
    depends_on:
      - order-service
    networks:
      - food-network
    volumes:
      - user-data:/data

networks:
  food-network:
    driver: bridge

volumes:
  order-data:
  user-data:
